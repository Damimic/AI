<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Kepler — Findings</title>
<style>
  body { font-family: -apple-system, sans-serif; margin: 2rem; color: #1a1a1a; }
  h1 { font-size: 1.25rem; }
  form { margin-bottom: 1rem; }
  select, button { font-size: 0.9rem; padding: 0.3rem; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #ddd; }
  th { background: #f5f5f5; }
  .sev-CRITICAL { color: #7a0000; font-weight: bold; }
  .sev-HIGH { color: #b30000; font-weight: bold; }
  .sev-MEDIUM { color: #a86a00; }
  .sev-LOW { color: #555; }
  .empty { color: #666; font-style: italic; }
  .count { color: #666; font-size: 0.85rem; margin-bottom: 1rem; }
</style>
</head>
<body>
<h1>Kepler Findings</h1>

<form method="get">
  <label>Host:
    <select name="host">
      <option value="">All hosts</option>
      {{range .Hostnames}}
      <option value="{{.}}" {{if eq . $.SelectedHost}}selected{{end}}>{{.}}</option>
      {{end}}
    </select>
  </label>
  <label>Severity:
    <select name="severity">
      <option value="">All severities</option>
      {{range .Severities}}
      <option value="{{.}}" {{if eq . $.SelectedSeverity}}selected{{end}}>{{.}}</option>
      {{end}}
    </select>
  </label>
  <button type="submit">Filter</button>
</form>

<div class="count">{{len .Findings}} finding(s)</div>

{{if .Findings}}
<table>
  <thead>
    <tr><th>Host</th><th>Package</th><th>Version</th><th>CVE</th><th>Severity</th><th>Fixed Version</th><th>Reported</th></tr>
  </thead>
  <tbody>
    {{range .Findings}}
    <tr>
      <td>{{.Host}}</td>
      <td>{{.Package}}</td>
      <td>{{.Version}}</td>
      <td><a href="https://nvd.nist.gov/vuln/detail/{{.CVEID}}" target="_blank" rel="noopener noreferrer">{{.CVEID}}</a></td>
      <td class="sev-{{.Severity}}">{{.Severity}}</td>
      <td>{{if .FixedVersion}}{{.FixedVersion}}{{else}}—{{end}}</td>
      <td>{{.ReportedAt.Format "2006-01-02 15:04"}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="empty">No findings match this filter.</p>
{{end}}

</body>
</html>
